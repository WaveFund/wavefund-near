# No environment variables or keys are required for local unit tests.
AURORA_TESTNET_RPC=https://testnet.aurora.dev
# Deployment requires verified addresses and explicit operator action.
# TRADING_SAFE=
# STABLE_TOKEN=
# INVESTMENT_TOKEN=
# INVESTMENT_ROUTER=
# PORTFOLIO_ORACLE=
# KEEPER_ADDRESS=
# FORECAST_POOL_MANAGER=
# DEPLOY_FORECAST_POOL_MANAGER=false
# OBSERVATION_WINDOW=900
# DEPLOYER_PK= # Supply securely only for a separately authorized deployment.

# Optional server-side gateway access. Never expose through NEXT_PUBLIC_* or commit a real value.
# REDSTONE_GATEWAY_API_KEY=

# Server-only configuration. NEVER put secrets in NEXT_PUBLIC_* variables.
# Copy to .env.agents and fill it privately. No value below is a real credential.
WAVEFUND_AGENT_MODE=near-ai
WAVEFUND_AGENT_MODEL=
NEARAI_API_KEY=
# Set to 1 only after choosing a model and confirming its inference charges.
WAVEFUND_ALLOW_REMOTE_INFERENCE=0
# Local alternative: WAVEFUND_AGENT_MODE=local, select an installed local model.
# WAVEFUND_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions

# Optional owner-controlled monitoring after actual Aurora deployment. No server signing.
# WAVEFUND_NETWORK=aurora-testnet
# AURORA_MANIFEST=deployments/aurora-testnet.json
# Optional research input (public REST data is NOT a settlement oracle).
# WAVEFUND_MARKET_DATA_FILE=.run/research/latest.json
