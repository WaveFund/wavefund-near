{
  "name": "wavefund-near",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "demo:local": "node scripts/local-demo.mjs",
    "dev:api": "WAVEFUND_TEE_POLICY=${WAVEFUND_TEE_POLICY:-docs/tee-policy.json} node runtime/server.mjs",
    "test:runtime": "node --test runtime/test/*.test.mjs runtime/funding/*.test.mjs scripts/lib/*.test.mjs",
    "frontend:build": "npm run build --workspace @wavefund/frontend",
    "frontend:typecheck": "npm run typecheck --workspace @wavefund/frontend",
    "demo:scenario": "node runtime/scenario.mjs",
    "agents:check": "node --env-file-if-exists=.env.agents runtime/agents/check.mjs",
    "agents:smoke": "node --env-file-if-exists=.env.agents scripts/agent-smoke.mjs",
    "demo:agents": "node --env-file=.env.agents scripts/local-demo.mjs",
    "research:collect": "node scripts/collect-research.mjs",
    "aurora:check": "node scripts/aurora-check.mjs",
    "journal:audit": "node scripts/journal-audit.mjs",
    "monitor:aurora": "WAVEFUND_NETWORK=aurora-testnet WAVEFUND_TEE_POLICY=${WAVEFUND_TEE_POLICY:-docs/tee-policy.json} node runtime/server.mjs",
    "evidence:static": "node scripts/build-static-evidence.mjs",
    "evidence:static:check": "node scripts/build-static-evidence.mjs --check"
  },
  "dependencies": {
    "@phala/dcap-qvl": "0.7.0",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "playwright": "1.65.0"
  }
}
